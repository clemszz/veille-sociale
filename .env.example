# Copier ce fichier en .env pour lancer la veille en local (python -m veille).
# Sur GitHub, ces valeurs se renseignent dans Settings > Secrets and variables > Actions.

# Clé API Google AI Studio (gratuite) : https://aistudio.google.com/apikey
# Vide = pas de résumés IA (extraits officiels bruts + thèmes par mots-clés).
GEMINI_API_KEY=

# Facultatif : modèle Gemini à utiliser (défaut : gemini-3.5-flash-lite, avec repli
# automatique sur gemini-3.8-flash puis gemini-flash-latest).
GEMINI_MODEL=
